# Copy to .env and fill in. The app validates every value at boot and refuses
# to start with a clear message rather than failing later inside a request.

NODE_ENV=development
LOG_LEVEL=info

# ── Server ────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=3040
# Comma-separated. The Scan Bridge helper keeps its own separate allowlist in
# C:\ProgramData\ScanBridge\appsettings.json — update that too for production.
CORS_ORIGINS=http://localhost:5173

# ── SQL Server ────────────────────────────────────────────────────────────
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=dms
DB_USER=dms_app
DB_PASSWORD=
# Database used by `npm run test:db`. The integration suite DELETES every row in
# the identity and filing-tree tables, so it never runs against DB_NAME — it is
# created on first run. Defaults to DB_NAME + "_test" when left unset.
TEST_DB_NAME=dms_test
# Self-signed certificates are normal on-prem. Set false only with a real cert.
DB_TRUST_SERVER_CERTIFICATE=true
DB_ENCRYPT=true
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_REQUEST_TIMEOUT_MS=30000

# ── Authentication ────────────────────────────────────────────────────────
# Session lifetime. Sliding: an in-use session is extended, but never past
# AUTH_SESSION_ABSOLUTE_TTL_HOURS measured from when it was created.
AUTH_SESSION_TTL_HOURS=12
AUTH_SESSION_ABSOLUTE_TTL_HOURS=168
# Failed attempts before a temporary lock, and how long it lasts.
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
# Length is the only composition rule, per NIST 800-63B.
AUTH_MIN_PASSWORD_LENGTH=12
AUTH_COOKIE_NAME=dms_session
# Requires HTTPS. Defaults to true in production; leave false for http://localhost.
AUTH_COOKIE_SECURE=false

# ── Text extraction (content search) ──────────────────────────────────────
# Drains extraction_queue and fills the full-text index. Without it, content
# search finds nothing -- title and metadata search are unaffected.
# NOTE: this reads a document's EXISTING text layer. A scanned page has none,
# so scans are recorded as "unsupported" until OCR exists.
EXTRACTION_ENABLED=true
EXTRACTION_POLL_MS=15000
EXTRACTION_BATCH_SIZE=25
EXTRACTION_MAX_ATTEMPTS=3
EXTRACTION_MAX_BYTES=67108864
EXTRACTION_MAX_CHARS=2000000

# ── Email (password reset links only) ─────────────────────────────────────
# Leave MAIL_HOST empty to keep the "log" transport, which writes reset links
# to the application log instead of sending them. Set AUTH_RESET_DELIVERY=smtp
# once this works, and verify with GET /api/admin/mail/status.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_REQUIRE_TLS=true
MAIL_REJECT_UNAUTHORIZED=true
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=DMS <no-reply@example.local>

# ── OCR (scanned documents) ───────────────────────────────────────────────
# OFF by default: it needs Tesseract 5 installed on the server, plus OCRmyPDF
# for scanned PDFs. Without it, scans are stored and browsable but their
# contents are not searchable.
#   Windows:  winget install UB-Mannheim.TesseractOCR
#             pip install ocrmypdf
#   Arabic data must be installed too -- the engine alone yields empty results.
# OCR output feeds the search index ONLY. It is never shown to a user as the
# document's text: ~85-93% on clean Arabic print is enough to find a document
# and nowhere near enough to read as a transcription.
OCR_ENABLED=false
OCR_LANGUAGES=ara+eng
OCR_TESSERACT_PATH=tesseract
OCR_OCRMYPDF_PATH=ocrmypdf
OCR_TIMEOUT_MS=300000
OCR_MIN_CHARACTERS=24
OCR_MAX_CHARS=2000000

# ── Document storage ──────────────────────────────────────────────────────
# Absolute local path or a UNC path. NEVER a mapped drive letter: a Windows
# service runs in its own logon session and cannot see mapped drives.
#   local :  D:\dms\storage
#   NAS   :  \\nas\dms\storage
STORAGE_ROOT=D:\dms\storage
STORAGE_TEMP_DIR=.tmp
STORAGE_MAX_TITLE_LENGTH=120
STORAGE_MAX_UPLOAD_BYTES=209715200
STORAGE_VERIFY_ON_READ_MAX_BYTES=4194304
STORAGE_PURGE_GRACE_DAYS=30
# The sweep that reclaims purged blobs and abandoned upload fragments.
STORAGE_PURGE_ENABLED=true
STORAGE_PURGE_INTERVAL_MS=3600000
# Per-month manifest.json files describing each storage directory. The layout is
# keyed on upload date, not the filing tree, so without these losing the database
# means losing the folder structure and metadata -- the files stay readable.
STORAGE_MANIFESTS_ENABLED=true

# ── Runtime ───────────────────────────────────────────────────────────────
# REQUIRED in production. Node defaults to 4 file-I/O worker threads; one stalled
# SMB session then blocks file I/O process-wide and every user times out, not just
# the one uploading. Set this in the pm2 ecosystem file too.
UV_THREADPOOL_SIZE=64
