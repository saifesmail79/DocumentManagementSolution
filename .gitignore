node_modules/
.env
.env.*
!.env.example

# Runtime output
server/logs/*.log
*.log

# Document storage — never commit user documents.
# Anchored to the repo root so it does not also swallow src/storage/.
/storage/
/blobs/

# Build output
dist/
build/
client/dist/
client/node_modules/

# Editor / OS
# Ignore personal editor settings but share the build task, so Ctrl+Shift+B works
# from a fresh clone. Exclude the contents, not the directory: git does not descend
# into an excluded directory, so a negation under `.vscode/` would never match.
.vscode/*
!.vscode/tasks.json
.idea/
Thumbs.db
Desktop.ini
*.swp
